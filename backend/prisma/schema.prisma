generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int          @id @default(autoincrement())
  username       String       @unique
  password       String       // bcrypt hash
  role           String       @default("PLAYER")
  // Organizzatore: resta PLAYER ma può creare e gestire i PROPRI eventi (assegnato dall'admin)
  isOrganizer    Boolean      @default(false)
  avatarCardName   String?
  avatarScryfallId String?    // UUID stampa Scryfall specifica scelta dall'utente
  createdAt        DateTime   @default(now())
  decks       Deck[]
  gamePlayers GamePlayer[]
  createdGames Game[]      @relation("GameCreator")
  comments    Comment[]
  reactions   Reaction[]
  createdEvents Event[]    @relation("EventCreator")
  eventRsvps  EventRsvp[]
  eventSeats  EventSeat[]
  notifications     Notification[] @relation("NotifRecipient")
  sentNotifications Notification[] @relation("NotifSender")
  achievementUnlocks AchievementUnlock[]
  judgeQuestions JudgeQuestion[]
  createdOpenTables OpenTable[] @relation("OpenTableCreator")
  openTableSeats    OpenTableSeat[]
}

model Deck {
  id          Int          @id @default(autoincrement())
  name        String
  commander   String?
  colors      String?      // es. "WUBRG"
  decklist    String?
  bracket     Int?         // 1=Casual, 2=Bilanciato, 3=Potente, 4=cEDH
  archetype   String?      // es. Aggro, Control, Combo, Midrange, Stax...
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
  userId      Int
  gamePlayers GamePlayer[]
  openTableSeats OpenTableSeat[]

  @@unique([userId, name])
}

model Game {
  id              Int          @id @default(autoincrement())
  playedAt        DateTime     @default(now())
  notes           String?
  createdByUserId Int?
  createdBy       User?        @relation("GameCreator", fields: [createdByUserId], references: [id])
  players         GamePlayer[]
  comments        Comment[]
  reactions       Reaction[]
  eventTable      EventTable?
  openTable       OpenTable?
}

model Comment {
  id        Int      @id @default(autoincrement())
  body      String
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  @@index([gameId])
}

model Reaction {
  id        Int      @id @default(autoincrement())
  emoji     String
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  @@unique([gameId, userId, emoji])
  @@index([gameId])
}

model Event {
  id              Int         @id @default(autoincrement())
  title           String
  description     String?
  startsAt        DateTime
  allDay          Boolean     @default(false)
  location        String?
  format          String?     // 'multiplayer' (pod Commander) | '1v1'
  bestOf          Int?        // 1 o 3, solo per 1v1
  createdAt       DateTime    @default(now())
  createdBy       User?       @relation("EventCreator", fields: [createdByUserId], references: [id])
  createdByUserId Int?
  rsvps           EventRsvp[]
  rounds          EventRound[]
  openTables      OpenTable[]

  @@index([startsAt])
}

// Un turno del torneo dentro un evento (pod multiplayer o pairing 1v1).
model EventRound {
  id        Int          @id @default(autoincrement())
  number    Int
  createdAt DateTime     @default(now())
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  tables    EventTable[]

  @@unique([eventId, number])
}

// Un tavolo: pod (3-5 posti) per multiplayer, pairing (2 posti) per 1v1.
model EventTable {
  id           Int         @id @default(autoincrement())
  number       Int
  done         Boolean     @default(false)
  // multiplayer: la partita registrata (conta nelle statistiche)
  gameId       Int?        @unique
  game         Game?       @relation(fields: [gameId], references: [id], onDelete: SetNull)
  // 1v1: punteggio e esito (winnerUserId null + isDraw => pareggio; entrambi null => in attesa)
  winnerUserId Int?
  isDraw       Boolean     @default(false)
  scoreA       Int?        // game vinti dal posto 0
  scoreB       Int?        // game vinti dal posto 1
  round        EventRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId      Int
  seats        EventSeat[]

  @@index([roundId])
}

// Un posto al tavolo = un iscritto. seat = posizione (0..n; per 1v1 0 e 1).
model EventSeat {
  id      Int        @id @default(autoincrement())
  seat    Int
  table   EventTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId Int
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  Int

  @@unique([tableId, userId])
  @@index([tableId])
}

model EventRsvp {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int

  @@unique([eventId, userId])
  @@index([eventId])
}

model Notification {
  id         Int      @id @default(autoincrement())
  type       String   // event | achievement | comment | reaction
  title      String
  body       String?
  link       String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation("NotifRecipient", fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  fromUser   User?    @relation("NotifSender", fields: [fromUserId], references: [id], onDelete: SetNull)
  fromUserId Int?

  @@index([userId, read])
}

// Snapshot degli achievement già sbloccati, per notificare solo i nuovi.
model AchievementUnlock {
  id            Int      @id @default(autoincrement())
  achievementId String
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int

  @@unique([userId, achievementId])
}

model JudgeQuestion {
  id          Int      @id @default(autoincrement())
  question    String
  answer      String
  explanation String?
  confidence  Float
  sourcesJson String   // JSON array di { type, id, text }
  rulesUsed   String   // JSON array di rule IDs
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int

  @@index([userId])
}

model GamePlayer {
  id             Int     @id @default(autoincrement())
  isWinner       Boolean @default(false)
  placement      Int?    // 1 = vincitore (ultimo in piedi), N = primo eliminato
  eliminatedById Int?    // userId di chi ha eliminato questo giocatore (null = sconosciuto)
  game           Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  gameId   Int
  user     User    @relation(fields: [userId], references: [id])
  userId   Int
  deck     Deck    @relation(fields: [deckId], references: [id])
  deckId   Int
}

// Tavolo aperto creato da un giocatore (fuori dai turni di torneo generati dall'admin).
// Aperto = altri possono sedersi fino a maxSeats; chiuso = nessun altro entra.
model OpenTable {
  id          Int             @id @default(autoincrement())
  title       String?
  startsAt    DateTime        @default(now())
  isOpen      Boolean         @default(true)
  maxSeats    Int             @default(5)
  createdAt   DateTime        @default(now())
  createdBy   User            @relation("OpenTableCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdById Int
  event       Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId     Int?
  game        Game?           @relation(fields: [gameId], references: [id], onDelete: SetNull)
  gameId      Int?            @unique
  seats       OpenTableSeat[]
  // Segnapunti condiviso della partita in corso (vita, veleno, danni da commander).
  // null = non ancora usato. scoreVersion: lock ottimistico contro aggiornamenti simultanei.
  scoreboard   Json?
  scoreVersion Int            @default(0)

  @@index([eventId])
  @@index([startsAt])
}

model OpenTableSeat {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now())
  table     OpenTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableId   Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  // Mazzo scelto per la partita al tavolo (null = non ancora scelto)
  deck      Deck?     @relation(fields: [deckId], references: [id], onDelete: SetNull)
  deckId    Int?

  @@unique([tableId, userId])
  @@index([tableId])
}
